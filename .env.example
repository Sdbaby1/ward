# Ward reads this file only if you export the variables yourself.
# Copy to .env and fill the blanks. Never commit .env.

# Server
PORT=8787

# memory: no database required. supabase: uses the SQL in supabase/schema.sql.
STORE=memory

# true uses the built-in fixtures so the attack demo runs with no keys.
# Set false only after NEAR_RPC_URL is set. A live blocklist also needs WARD_CONTRACT_ID.
DEMO_FIXTURES=true

# testnet or mainnet. NEAR Intents has no testnet; this product's contract does.
NEAR_NETWORK=testnet

# Public RPC. Required when DEMO_FIXTURES=false.
NEAR_RPC_URL=https://rpc.testnet.near.org

# Optional archival RPC. Ward does not require it.
NEAR_ARCHIVAL_RPC_URL=https://archival-rpc.testnet.near.org

# Public indexer for account age and transaction count. No API key.
NEARBLOCKS_API_URL=https://api.nearblocks.io

# Deployed Ward contract account. Leave empty until you deploy.
WARD_CONTRACT_ID=

# Treasury the agent key is scoped to. In the demo this is treasury.ward.testnet.
WARD_TREASURY_CONTRACT_ID=treasury.ward.testnet

# Agent account that holds the function-call key. Not a private key.
WARD_AGENT_ACCOUNT_ID=pay-agent.ward.testnet

# ed25519 public key of the function-call key. Not a private key.
WARD_AGENT_PUBLIC_KEY=ed25519:demo

# Gas allowance of that key, in yoctoNEAR. 0.25 NEAR is the recommended demo budget.
WARD_AGENT_ALLOWANCE_YOCTO=250000000000000000000000

# Supabase. Use the service role on the server only. Never put it in a VITE_ or NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Spending backstop mirrored from the contract init args. 5 NEAR and 20 NEAR.
WARD_MAX_PER_TX_YOCTO=5000000000000000000000000
WARD_DAILY_LIMIT_YOCTO=20000000000000000000000000
