{
  "name": "ward",
  "version": "1.0.0",
  "private": true,
  "description": "Counterparty check for AI agents that pay on NEAR. Allow, warn, or block before the signature.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "predev": "node scripts/embed-public.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "prebuild": "node scripts/embed-public.mjs",
    "build": "tsc -p tsconfig.json",
    "pretest": "node scripts/embed-public.mjs",
    "test": "vitest run",
    "demo": "tsx src/demo/attack.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "hono": "^4.10.4"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
